# From @BotFather (/mybots -> your bot -> API Token). Business Mode must
# also be turned on there -- see README's "Что делать руками" section.
BOT_TOKEN=

# console.anthropic.com -> API Keys. Set a spend limit there too (README
# reminds you again in the budget section).
ANTHROPIC_API_KEY=

# Your own numeric Telegram user id (NOT @username) -- the bot only ever
# operates on a Business connection made by this account, and only this
# user's direct messages to the bot are accepted as owner commands. Get it
# from e.g. @userinfobot.
OWNER_USER_ID=

# Model used for every reply/SKIP/RUDE/ACTION decision. claude-haiku-4-5 is
# the cheapest/fastest option (ТЗ default); claude-sonnet-5 costs ~2x but
# reads livelier -- swap PRICE_INPUT_PER_MTOK/PRICE_OUTPUT_PER_MTOK below to
# match whichever you pick, or /stats and the budget guard will be wrong.
LLM_MODEL=claude-sonnet-5

# Hard cap on one reply's length (tokens). Small on purpose -- replies are
# meant to be 1-2 sentences.
MAX_OUTPUT_TOKENS=150

# How much chat history goes into each LLM call: last N messages, trimmed
# further to fit under HISTORY_MAX_TOKENS (oldest dropped first).
HISTORY_MESSAGES=12
HISTORY_MAX_TOKENS=1500

# Debounce: wait this long after the last message in a burst before calling
# the LLM once for the whole burst, but never longer than DEBOUNCE_MAX_SEC
# from the first message.
DEBOUNCE_SEC=20
DEBOUNCE_MAX_SEC=60

# Rate limits -- sliding windows, persisted in sqlite (survive a restart).
# Counts every LLM call (including SKIP decisions), not just sent replies.
# CHAT_LIMIT/CHAT_WINDOW_SEC is effectively a minimum gap between replies in
# one chat (1 per 60s here) -- a steady cap during an actual back-and-forth
# conversation, rather than a burst-of-3-then-silent-for-5-minutes wall.
GLOBAL_LIMIT=10
GLOBAL_WINDOW_SEC=120
CHAT_LIMIT=1
CHAT_WINDOW_SEC=60
CHAT_DAILY_LIMIT=20

# If you (the real account owner) sent a message in a chat yourself in the
# last N minutes, the bot stays quiet there -- it never talks over you.
OWNER_ACTIVE_PAUSE_MIN=5

# Hard money ceilings. Once today's/this month's spend (computed from actual
# API usage) reaches these, the bot auto-pauses and notifies you. Calendar
# day/month, server-local time.
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=15.0

# Claude Sonnet 5 pricing, per million tokens, as of 2026-09 -- verify at
# https://www.anthropic.com/pricing before relying on these in production.
# Haiku 4.5 is $1.00/$5.00 if you switch LLM_MODEL back.
PRICE_INPUT_PER_MTOK=2.00
PRICE_OUTPUT_PER_MTOK=10.00

# Ping OWNER_USER_ID with a short note whenever the LLM decides SKIP.
NOTIFY_ON_SKIP=true

# Chat history (other people's messages) is deleted after this many days.
HISTORY_TTL_DAYS=7

# Comma-separated numeric user ids. BLACKLIST is never replied to. If
# WHITELIST is non-empty, ONLY those ids get replies (blacklist still wins).
BLACKLIST=
WHITELIST=
